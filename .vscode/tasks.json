{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PHP server (ÉdoLeo)",
      "type": "process",
      "command": "C:\\xampp\\php\\php.exe",
      "args": ["-S", "127.0.0.1:8000"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^\\[.*\\] PHP (?:Fatal error|Parse error|Warning|Notice|Deprecated):\\s*(.*?) in (.+) on line (\\d+)$",
          "file": 2,
          "line": 3,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Development Server.*started.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "group": "none"
    },
    {
      "label": "Abrir ÉdoLeo no navegador",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-Command", "Start-Process 'http://127.0.0.1:8000/'"],
      "problemMatcher": [],
      "group": "none"
    },
    {
      "label": "Go Live (ÉdoLeo via PHP)",
      "dependsOn": ["PHP server (ÉdoLeo)", "Abrir ÉdoLeo no navegador"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
